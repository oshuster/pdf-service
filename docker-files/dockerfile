ENV PORT=8180
ENV ENVIRONMENT=PRODUCTION
ENV ENVIRONMENT=debug

WORKDIR /app/pdf-service

RUN git clone -b optimization https://github.com/oshuster/pdf-service.git .

RUN npm install

EXPOSE 8180

CMD ["npm", "start"]